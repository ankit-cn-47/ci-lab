[Unit]
Description=Renew {{ item.domain }} TLS certificate for Nginx
After=network-online.target
Wants=network-online.target

[Service]
Type=simple
User=root
ExecStart=/usr/bin/step ca renew {{ nginx_tls_certificate_dir }}/{{ item.domain }}.{{ nginx_tls_certificate_extension }} {{ nginx_tls_private_key_dir }}/{{ item.domain }}.{{ nginx_tls_private_key_extension }} --daemon --exec="{{ step_ca_renew_exec }}" --ca-url={{ lab_ca_url }} --root={{ lab_ca_root_cert_path }}
Restart=on-failure
RestartSec=30s
NoNewPrivileges=true
PrivateTmp=true

[Install]
WantedBy=multi-user.target
