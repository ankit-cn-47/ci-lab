WOODPECKER_OPEN=false
WOODPECKER_HOST={{ woodpecker_host_url | to_json }}
WOODPECKER_GITEA=true
WOODPECKER_GITEA_URL={{ woodpecker_gitea_url | to_json }}
WOODPECKER_GITEA_CLIENT={{ woodpecker_gitea_client_id | to_json }}
WOODPECKER_GITEA_SECRET={{ woodpecker_gitea_client_secret | to_json }}
WOODPECKER_AGENT_SECRET={{ woodpecker_agent_secret | to_json }}
WOODPECKER_GRPC_SECRET={{ woodpecker_grpc_secret | to_json }}
WOODPECKER_SERVER_ADDR={{ (woodpecker_http_addr ~ ':' ~ woodpecker_http_port) | to_json }}
WOODPECKER_GRPC_ADDR={{ woodpecker_grpc_addr | to_json }}
WOODPECKER_DATABASE_DRIVER=sqlite3
WOODPECKER_DATABASE_DATASOURCE={{ (woodpecker_data_dir ~ '/woodpecker.sqlite') | to_json }}
