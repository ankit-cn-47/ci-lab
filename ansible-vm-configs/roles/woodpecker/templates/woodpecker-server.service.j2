[Unit]
Description=Woodpecker CI server
After=network.target

[Service]
Type=simple
User=woodpecker
Group=woodpecker
EnvironmentFile=/etc/woodpecker/server
ExecStart=/usr/local/bin/woodpecker-server
Restart=always
RestartSec=2s
NoNewPrivileges=true
PrivateTmp=true
ProtectSystem=full
ProtectHome=true
ReadWritePaths={{ woodpecker_data_dir }}

[Install]
WantedBy=multi-user.target
